{
  "name": "govuk-one-login-frontend",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nx run-many --target=build",
    "test": "nx affected --target=test",
    "lint": "nx affected --target=lint",
    "lint:fix": "biome check --write .",
    "format": "nx affected --target=format",
    "format:check": "nx affected --target=format:check",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prep:commit": "npm run format && npm run lint",
    "prepare": "husky",
    "prepare-dependencies": "npm run prepare-dependencies:canvas",
    "prepare-dependencies:canvas": "cd ./node_modules/canvas && prebuild-install -r napi || node-gyp rebuild"
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.1006.0",
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@cucumber/cucumber": "^13.0.0",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@playwright/test": "^1.60.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/chai": "^4.3.20",
    "@types/express": "5.0.1",
    "@types/express-session": "^1.19.0",
    "@types/jest": "29.5.14",
    "@types/jest-axe": "3.5.9",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "4.17.15",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "22.13.13",
    "@types/nunjucks": "^3.2.6",
    "@types/overload-protection": "^1.2.4",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "^4.1.2",
    "axe-core": "^4.11.0",
    "canvas": "^3.2.0",
    "chai": "^4.5.0",
    "chai-subset": "^1.6.0",
    "clean-css": "^5.3.3",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "helmet": "^8.1.0",
    "husky": "^9.1.7",
    "jest": "29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "joi": "^17.13.3",
    "jsdom": "26.0.0",
    "npm-run-all2": "^7.0.2",
    "nunjucks": "^3.2.4",
    "nx": "23.1.1",
    "playwright": "^1.62.1",
    "rollup": "4.59.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-scss": "4.0.1",
    "rollup-plugin-typescript2": "0.37.0",
    "sass": "1.86.0",
    "start-server-and-test": "3.0.11",
    "supertest": "7.1.0",
    "ts-jest": "29.3.0",
    "ts-node": "^10.9.2",
    "tslib": "2.8.1",
    "tsx": "4.22.4",
    "typescript": "5.8.2",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "jest-environment-jsdom": {
      "canvas": "$canvas"
    },
    "axios": "1.18.1",
    "brace-expansion@>=5.0.0": "5.0.9",
    "brace-expansion@>=2.0.0 <5.0.0": "2.1.4",
    "brace-expansion@>=1.0.0 <2.0.0": "1.1.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "npm run precommit"
    }
  },
  "repository": {
    "url": "https://github.com/govuk-one-login/govuk-one-login-frontend"
  }
}
