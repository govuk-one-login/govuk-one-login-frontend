{% extends 'common/base.njk' %}

{% set title = 'pages.componentLibrary.title' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/accordion/macro.njk" import govukAccordion %}

{% block backLink %}
