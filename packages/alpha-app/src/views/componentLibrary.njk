    <a class="govuk-link" href="components/inset-text">{{"pages.componentLibrary.components.inset-text" | translate}}</a>
  </li>
  <li>
    <a class="govuk-link" href="components/radios">{{"pages.componentLibrary.components.radios" | translate}}</a>
  </li>
  <li>
    <a class="govuk-link" href="components/select">{{"pages.componentLibrary.components.select" | translate}}</a>
  </li>
  <li>
    <a class="govuk-link" href="components/step-card">{{"pages.componentLibrary.components.step-card" | translate}}</a>
